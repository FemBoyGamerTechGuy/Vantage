# Maintainer: Vantage Desktop Project
pkgname=vantage
pkgver=0.2.0
pkgrel=1
pkgdesc="Lightweight raw-C desktop environment — Wayland compositor + X11 backend, cross-toolkit Qt6/GTK theming, live video wallpapers"
arch=('x86_64' 'aarch64')
url="https://github.com/FemBoyGamerTechGuy/Vantage"
license=('GPL-2.0-or-later')
depends=(
  'glibc'
)
makedepends=(
  'meson' 'ninja' 'gcc' 'pkg-config'
)
optdepends=(
  'libxcb: X11 core protocol'
  'libxkbcommon: keyboard layouts'
  'wayland: Wayland backend'
  'libglvnd: OpenGL/EGL'
  'mesa: OpenGL/EGL/GBM'
  'vulkan-icd-loader: Vulkan renderer (optional)'
  'libdrm: GPU detection'
  'json-c: theme JSON parser'
  'gdk-pixbuf2: image wallpaper'
  'libpng: PNG wallpaper'
  'libjpeg-turbo: JPEG wallpaper'
  'ffmpeg: video wallpaper'
  'pipewire: audio (preferred)'
  'libpulse: audio (alternative)'
  'alsa-lib: audio (fallback)'
  'networkmanager: network status'
  'upower: power + battery'
  'systemd-libs: power via logind (systemd)'
  'elogind: power via logind (systemd-free)'
  'dbus: optional D-Bus integration'
)
provides=("vantage=$pkgver")
# released package vs. AUR git build of the same name; a package never
# conflicts with its own name
conflicts=('vantage-git')
source=("git+https://github.com/FemBoyGamerTechGuy/Vantage.git")
sha256sums=('SKIP')

# NOTE: this PKGBUILD is the source-build alternative for AUR-style
# usage. Vantage's own packaging interface is `./build packages arch`,
# which produces the .pkg.tar.zst directly (packaging/arch/package.sh).
build() {
  cd "$srcdir/Vantage"
  meson setup build --prefix=/usr --buildtype=release -Dsysconfdir=/etc
  ninja -C build
}

check() {
  cd "$srcdir/Vantage"
  meson test -C build
}

package() {
  cd "$srcdir/Vantage"
  DESTDIR="$pkgdir" ninja -C build install
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
